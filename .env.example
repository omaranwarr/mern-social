# Server
PORT=3000
NODE_ENV=development

# MongoDB (default: mongodb://localhost:27017/mernproject)
MONGODB_URI=mongodb://localhost:27017/mernproject

# JWT
JWT_SECRET=your_secret_key_here

# Email (2FA verification code) - uncomment and set to send real emails
# Without these, the app uses Ethereal (test inbox); check server console for "Ethereal preview URL".
# Gmail: use an App Password (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="MERN Social <your.email@gmail.com>"
